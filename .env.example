# Copy this file to `.env.local` for local development. Never commit real keys.
# On Vercel, add the same names under Project Settings → Environment Variables.
#
# Nothing here is required to run `npm run dev`: without email settings,
# submitted forms are printed to the terminal instead of being sent.

# ── Site ─────────────────────────────────────────────────────────────────────

# Public URL of the deployed site, with no trailing slash. Used for canonical
# URLs, Open Graph tags, sitemap.xml and robots.txt.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Shown on the Contact page and in the footer. PLACEHOLDER until you set it:
# the site currently shows hello@example.com, which cannot receive mail.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional social profiles. Only the ones you fill in are shown.
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-page
# NEXT_PUBLIC_X_URL=https://x.com/your-handle
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle
# NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# ── Email delivery (Resend, https://resend.com) ──────────────────────────────

# API key from the Resend dashboard.
RESEND_API_KEY=

# Where form submissions are delivered. Comma-separate several addresses.
NOTIFICATION_TO=

# Sender address. Must use a domain you have verified in Resend. If unset,
# Resend's shared test sender (onboarding@resend.dev) is used, which can only
# deliver to the email address of your own Resend account.
# EMAIL_FROM="Syntior <noreply@your-domain.example>"

# Log emails to the server console instead of sending them, in any
# environment. Handy for preview deployments.
# EMAIL_DRY_RUN=true
